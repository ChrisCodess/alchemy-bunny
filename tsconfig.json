{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // The workspace packages resolve to their sources, so a fresh clone
    // typechecks before anything is built. (Their `exports` point
    // TypeScript at the built lib/*.d.ts, which is what consumers get.)
    "paths": {
      "alchemy-bunny-sdk": ["./packages/bunny-sdk/src/index.ts"],
      "alchemy-bunny-sdk/*": ["./packages/bunny-sdk/src/*.ts"],
      "alchemy-bunny": ["./packages/bunny/src/index.ts"],
      "alchemy-bunny/*": ["./packages/bunny/src/*.ts"]
    }
  },
  // Build output and framework app sources (checked by their own toolchain)
  // are not part of this program.
  "exclude": ["node_modules", "repos", "packages/*/lib", "examples/tanstack-start/src"]
}
