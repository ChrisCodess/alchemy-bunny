{
  "name": "alchemy-bunny-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/bunny-sdk build && bun run --cwd packages/bunny build",
    "typecheck": "tsc -p . --noEmit",
    "test": "bun test",
    "pack": "bun scripts/pack.ts"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.83",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
