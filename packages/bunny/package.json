{
  "name": "alchemy-bunny",
  "version": "0.1.0",
  "description": "bunny.net provider for Alchemy: storage and pull zones, Edge Scripts, Bunny Database, bindings, and website composites.",
  "homepage": "https://github.com/ChrisCodess/alchemy-bunny#readme",
  "license": "Apache-2.0",
  "author": "Chris Almond",
  "keywords": [
    "alchemy",
    "bunny.net",
    "bunnycdn",
    "effect",
    "infrastructure-as-code",
    "edge-scripting",
    "cdn"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisCodess/alchemy-bunny.git",
    "directory": "packages/bunny"
  },
  "bugs": {
    "url": "https://github.com/ChrisCodess/alchemy-bunny/issues"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "import": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun ../../scripts/copy-package-files.ts bunny",
    "prepack": "bun run build"
  },
  "dependencies": {
    "alchemy-bunny-sdk": "workspace:*",
    "@bunny.net/database-client": "0.0.3",
    "@bunny.net/edgescript-sdk": "0.13.0"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.83",
    "effect": "^4.0.0",
    "@alchemy.run/better-auth": "2.0.0-beta.83",
    "better-auth": "^1.7.5",
    "kysely": "^0.29.4"
  },
  "devDependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.83",
    "@effect/platform-bun": "4.0.5",
    "alchemy": "2.0.0-beta.83",
    "better-auth": "1.7.6",
    "effect": "4.0.5",
    "kysely": "0.29.6"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/better-auth": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
