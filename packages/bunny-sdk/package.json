{
  "name": "alchemy-bunny-sdk",
  "version": "0.1.0",
  "description": "Effect SDK for the bunny.net APIs (core, Edge Scripting, Bunny Database, Edge Storage, SQL over Hrana).",
  "homepage": "https://github.com/ChrisCodess/alchemy-bunny#readme",
  "license": "Apache-2.0",
  "author": "Chris Almond",
  "keywords": [
    "bunny.net",
    "bunnycdn",
    "effect",
    "sdk",
    "cdn",
    "edge-storage",
    "bunny-database"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisCodess/alchemy-bunny.git",
    "directory": "packages/bunny-sdk"
  },
  "bugs": {
    "url": "https://github.com/ChrisCodess/alchemy-bunny/issues"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "import": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun ../../scripts/copy-package-files.ts bunny-sdk",
    "prepack": "bun run build",
    "fetch-specs": "bun scripts/fetch-specs.ts",
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/generate.ts"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.12"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117",
    "oxfmt": "^0.66.0"
  }
}
