{
  "description": "Storage zone and pull zone names are global across bunny.net. A taken name comes back as 409, or as 400 whose message says the name already exists / is taken / is not available (official Bunny CLI, sites/api.ts isNameTaken). Surface both as a typed NameTaken error on the create operations. A storage zone name stays blocked after the zone is deleted: creating it again returns 400 \"The storage zone is currently being deleted.\" (observed on the live API, 2026-09-29). Surface that as NameBeingDeleted.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/net.bunny.core#NameTaken",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 409
            },
            {
              "status": 400,
              "message": {
                "matches": "[Aa]lready (exists|taken|in use)|[Nn]ot available|[Ii]s taken"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/net.bunny.core#CreateStorageZone/errors/-",
      "value": {
        "target": "net.bunny.core#NameTaken"
      }
    },
    {
      "op": "add",
      "path": "/shapes/net.bunny.core#CreatePullZone/errors/-",
      "value": {
        "target": "net.bunny.core#NameTaken"
      }
    },
    {
      "op": "add",
      "path": "/shapes/net.bunny.core#NameBeingDeleted",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "currently being deleted"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/net.bunny.core#CreateStorageZone/errors/-",
      "value": {
        "target": "net.bunny.core#NameBeingDeleted"
      }
    }
  ]
}
